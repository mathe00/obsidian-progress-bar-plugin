{
  "name": "obsidian-progress-bar-plugin",
  "version": "1.2.0",
  "description": "Interactive progress bars for Obsidian notes - click to increment, right-click to reset",
  "main": "main.js",
  "scripts": {
    "dev": "bun esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && bun esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version": "bun version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,mts}\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,mts}\" \"*.mjs\"",
    "fix": "bun run lint:fix && bun run format",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "progress-bar",
    "habit-tracking"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
